public class Main {
    public static void main(String[] args) {

        Manager m = new Manager("Krish", 101, 80000, 5);
        Developer d = new Developer("Rahul", 102, 60000, "Java");
        Intern i = new Intern("Aman", 103, 20000, 6);

        System.out.println("Manager Details:");
        m.displayDetails();

        System.out.println("\nDeveloper Details:");
        d.displayDetails();

        System.out.println("\nIntern Details:");
        i.displayDetails();
    }
}